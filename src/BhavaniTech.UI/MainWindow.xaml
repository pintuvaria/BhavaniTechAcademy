<Window x:Class="BhavaniTech.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bhavani Technology — Technology Learning &amp; Coding Academy"
        Icon="Assets/app_logo.png"
        Height="728" Width="1024"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- HIGH CONTRAST READABLE SIDEBAR NAVIGATION BUTTON STYLE -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="indicator" Grid.Column="0" Background="#38BDF8" CornerRadius="2" Visibility="Hidden" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HIGH READABILITY TAB ITEM STYLE -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content" ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header with Logo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="Assets/app_logo.jpg" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BHAVANI TECH" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="Academy" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Founder: Dharmesh Varia" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 4 Logical Navigation Stations -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavStack">
                        <RadioButton x:Name="NavDashboard" Content="🏠 Learning HQ &amp; Syllabus" Style="{StaticResource NavRadioButtonStyle}" IsChecked="True" Click="Nav_Click" Tag="Dashboard"/>
                        <RadioButton x:Name="NavCourses" Content="📚 Active Study Hall" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="Courses"/>
                        <RadioButton x:Name="NavZeroToHero" Content="🚀 Zero to Hero (Mastery)" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="ZeroToHero"/>
                        <RadioButton x:Name="NavGaming" Content="🎮 Learn with Gaming (Arcade)" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="Gaming"/>
                        <RadioButton x:Name="NavLabs" Content="🔬 Creative Workbenches" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="Labs"/>
                        <RadioButton x:Name="NavMastery" Content="🏆 Progress &amp; Diploma" Style="{StaticResource NavRadioButtonStyle}" Click="Nav_Click" Tag="Mastery"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtRamStatus" Text="RAM: 45 MB" FontSize="11" Foreground="#4ADE80" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtPerfStatus" Text="Mode: LOW-HARDWARE" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        <Button Content="🧹 Trim RAM" Click="BtnTrimRam_Click" Margin="0,6,0,0" Padding="4,2" FontSize="10" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Status Bar -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtActiveTabTitle" Text="Student Dashboard" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="100% OFFLINE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="4,0">
                            <TextBlock x:Name="TxtUserXp" Text="⭐ 150 XP" FontSize="12" FontWeight="Bold" Foreground="#FACC15"/>
                        </Border>
                        <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="4,0">
                            <TextBlock x:Name="TxtUserLevel" Text="Lvl 2" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                        <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="4,0">
                            <TextBlock x:Name="TxtUserStreak" Text="🔥 3 Day Streak" FontSize="12" FontWeight="Bold" Foreground="#FB923C"/>
                        </Border>
                        <Button x:Name="BtnStopVoice" Content="⏹️ Stop Voice" Click="BtnStopVoice_Click" Background="#475569" Foreground="White" Padding="8,4" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="4,0"/>
                        <ComboBox x:Name="CmbTheme" SelectionChanged="CmbTheme_SelectionChanged" Background="#0F172A" Foreground="White" Padding="6,2" FontSize="11" Margin="4,0" Cursor="Hand">
                            <ComboBoxItem Content="🌙 Cyber Dark" IsSelected="True"/>
                            <ComboBoxItem Content="☀️ Daylight Light"/>
                            <ComboBoxItem Content="📟 Terminal Green"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DYNAMIC VIEW TAB CONTAINER -->
            <Grid Grid.Row="1">
                <!-- 1. STUDENT LEARNING HQ & SYLLABUS -->
                <ScrollViewer x:Name="ViewDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Hero Continuity Card (Open App -> Learn -> Close -> Compounding Next Time) -->
                        <Border Background="#0F172A" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="CONTINUOUS LEARNING JOURNEY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock x:Name="TxtHeroStreakBadge" Text="🔥 Active Streak: 3 Days" FontSize="11" FontWeight="Bold" Foreground="#FB923C" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtHeroGreeting" Text="Welcome back, Student! Ready to learn today?" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock x:Name="TxtHeroCourseTitle" Text="Active Track: Polyglot Programming &amp; Software Building" FontSize="14" Foreground="#38BDF8" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtHeroLessonTitle" Text="Next Milestone: Lesson 1 — Python Variables &amp; Algorithm Foundations" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,8"/>

                                    <Grid Margin="0,4,0,8" MaxWidth="500" HorizontalAlignment="Left">
                                        <ProgressBar x:Name="PbHeroProgress" Value="15" Maximum="100" Height="8" Width="400" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtHeroProgressPct" Text="Curriculum Progress: 15% Complete (66 Interactive Lessons in Academy)" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button x:Name="BtnHeroContinue" Content="▶ CONTINUE LEARNING" Click="BtnHeroContinue_Click" Background="#16A34A" Foreground="White" FontSize="14" FontWeight="Bold" Padding="20,12" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand" ToolTip="Jump straight into your next interactive lesson"/>
                                    <Button x:Name="BtnHeroExploreLabs" Content="🚀 Creative Workbenches" Click="BtnHeroExploreLabs_Click" Background="#334155" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand" ToolTip="Freely build websites, calculators, and experiment"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Key Session & Retention Metrics -->
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="ACADEMIC PROGRESS" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtMetricLessonsDone" Text="10 / 66 Lessons" FontSize="16" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0"/>
                                    <TextBlock Text="Each lesson includes theory, lab, and quiz" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="PROJECTS &amp; LABS BUILT" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock Text="Web Studio + Calculator" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                    <TextBlock Text="Live interactive DOM &amp; mathematical engines" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="OFFLINE CERTIFICATION" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock Text="Diploma Track Active" FontSize="16" FontWeight="Bold" Foreground="#FACC15" Margin="0,4,0,0"/>
                                    <TextBlock Text="Verifiable cryptographic diploma awarded on exam pass" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Structured Curriculum Roadmaps -->
                        <TextBlock Text="STRUCTURED LEARNING ROADMAPS (BASICS TO MASTERS)" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <!-- Track 1 -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🖥️ Track 1: Computer Fundamentals &amp; Hardware" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="From binary bits, digital logic, and CPU ALUs to virtual memory, RAM latencies, and 2nm chip lithography." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Start / Resume Track" Click="TrackSelect_Click" Tag="CS101" Background="#0284C7" Foreground="White" Padding="10,6" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Track 2 -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="💻 Track 2: Polyglot Coding &amp; Software Engineering" FontSize="15" FontWeight="Bold" Foreground="#4ADE80"/>
                                    <TextBlock Text="Master Python, C#, JavaScript, HTML/CSS, SQL, C++, Rust, Java, and Go. Build real websites and calculators." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Start / Resume Track" Click="TrackSelect_Click" Tag="PROG101" Background="#16A34A" Foreground="White" Padding="10,6" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Track 3 -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🐧 Track 3: Linux Systems &amp; Networking Academy" FontSize="15" FontWeight="Bold" Foreground="#FACC15"/>
                                    <TextBlock Text="Command-line Unix administration, bash scripting, file permissions, OSI 7-layer model, and CIDR subnetting." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Start / Resume Track" Click="TrackSelect_Click" Tag="LNX101" Background="#D97706" Foreground="White" Padding="10,6" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Track 4 -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🛡️ Track 4: Cybersecurity &amp; Ethical Hacking" FontSize="15" FontWeight="Bold" Foreground="#F87171"/>
                                    <TextBlock Text="Safe educational hacking labs: RSA cipher math, Diffie-Hellman exchanges, AES-GCM tamper detection, and CTF challenges." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Start / Resume Track" Click="TrackSelect_Click" Tag="SEC101" Background="#DC2626" Foreground="White" Padding="10,6" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Track 5 -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🤖 Track 5: AI Frontier, Electronics &amp; Troubleshooting" FontSize="15" FontWeight="Bold" Foreground="#A855F7"/>
                                    <TextBlock Text="Interactive breadboard circuits, Arduino PWM, multi-layer neural networks, 3x3 convolutions, and 500+ IT scenarios." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Start / Resume Track" Click="TrackSelect_Click" Tag="AI101" Background="#9333EA" Foreground="White" Padding="10,6" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Track 6 -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🏆 Track 6: Technology Mastery &amp; Diploma" FontSize="15" FontWeight="Bold" Foreground="#FB923C"/>
                                    <TextBlock Text="Complete comprehensive assessment exams, unlock 12 mastery skill badges, and earn verifiable cryptographic diplomas." FontSize="12" Foreground="#CBD5E1" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Take Mastery Exam" Click="TrackSelect_Click" Tag="MAST101" Background="#EA580C" Foreground="White" Padding="10,6" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. COURSES & LESSONS VIEW (BASICS TO MASTERS) -->
                <Grid x:Name="ViewCourses" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Course & Lesson List -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="1. SEARCH &amp; SELECT COURSE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCourseSearch" TextChanged="TxtCourseSearch_TextChanged" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Padding="6,4" FontSize="12"/>
                                <Button Grid.Column="1" Content="✕" Click="BtnClearCourseSearch_Click" Background="#334155" Foreground="#CBD5E1" Padding="8,4" Margin="4,0,0,0" BorderThickness="0" Cursor="Hand" ToolTip="Clear Search Filter"/>
                            </Grid>

                            <ListBox x:Name="LstCourses" Grid.Row="2" SelectionChanged="LstCourses_SelectionChanged" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="3" Text="2. MASTERY LEVEL FILTER" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbLessonDifficulty" Grid.Row="4" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="CmbLessonDifficulty_SelectionChanged">
                                <ComboBoxItem Content="All Levels"/>
                                <ComboBoxItem Content="Basics"/>
                                <ComboBoxItem Content="Intermediate"/>
                                <ComboBoxItem Content="Advanced"/>
                                <ComboBoxItem Content="Master"/>
                                <ComboBoxItem Content="Grandmaster"/>
                                <ComboBoxItem Content="Cutting-Edge"/>
                            </ComboBox>

                            <ListBox x:Name="LstLessons" Grid.Row="5" SelectionChanged="LstLessons_SelectionChanged" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" Foreground="#38BDF8"/>
                        </Grid>
                    </Border>

                    <!-- Lesson Reader & Quiz Box -->
                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLessonTitle" Text="Select a Course &amp; Lesson to Begin" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TxtLessonMeta" Text="Duration: -- mins | Level: --" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnSpeakLesson" Content="🔊 Voice Mentor Read Aloud" Click="BtnSpeakLesson_Click" Background="#0284C7" Foreground="White" Padding="12,6" FontWeight="Bold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Listen to this lesson narrated by offline Voice Mentor"/>
                            </Grid>
                            
                            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <TabItem Header="📖 Lesson Content" Padding="14,8">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                            <TextBox x:Name="TxtLessonContent" IsReadOnly="True" Background="#020617" Foreground="#F8FAFC" FontSize="13" TextWrapping="Wrap" BorderThickness="1" BorderBrush="#334155" Padding="12" FontFamily="Segoe UI"/>
                                        </ScrollViewer>
                                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="🔬 Open Course Workbench Lab" Click="BtnLaunchLessonLab_Click" Background="#0284C7" Foreground="White" Padding="14,6" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Open the hands-on creative workbench lab for this topic"/>
                                                <Button x:Name="BtnCompleteLesson" Content="✅ Mark Completed &amp; Advance (+50 XP)" Click="BtnCompleteLesson_Click" Background="#16A34A" Foreground="White" Padding="14,6" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <!-- TAB 2: COURSE BLUEPRINT, PREREQUISITES & INSTALLATION STEPS -->
                                <TabItem Header="🛠️ Course Blueprint &amp; Setup" Padding="14,8">
                                    <Border Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtCourseDetailsTitle" Text="Course Blueprint &amp; Prerequisites" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock x:Name="TxtCourseDetailsCategory" Text="Category: -- | Code: --" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="📌 ACADEMIC &amp; KNOWLEDGE PREREQUISITES" FontSize="12" FontWeight="Bold" Foreground="#FACC15" Margin="0,4,0,4"/>
                                                <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                                    <TextBlock x:Name="TxtCoursePrerequisites" Text="Loading prerequisites..." FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                                </Border>

                                                <TextBlock Text="⚙️ STEP-BY-STEP INSTALLATION &amp; TOOL SETUP" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,4"/>
                                                <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,12">
