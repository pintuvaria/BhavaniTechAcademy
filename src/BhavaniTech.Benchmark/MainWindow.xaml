<Window x:Class="BhavaniTech.Benchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bhavani Technology — Low-Hardware Diagnostics &amp; Benchmark Suite"
        Icon="Assets/app_logo.jpg"
        Height="700" Width="980"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="10" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Source="Assets/app_logo.jpg" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BHAVANI TECHNOLOGY" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="Low-End PC Hardware Benchmark &amp; Resource Validation Suite" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        <TextBlock Text="Target Machine: 1.2 GHz Single-Core | 2 GB RAM | HDD | Integrated Graphics" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunBenchmark" Content="⚡ Run Full Benchmark" Click="BtnRunBenchmark_Click" Background="#0284C7" Foreground="White" Padding="14,8" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="BtnToggleSoftwareRender" Content="🖥️ Toggle Software Render" Click="BtnToggleSoftwareRender_Click" Background="#334155" Foreground="White" Padding="12,8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Metrics Display Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <!-- Startup Time -->
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4">
                <StackPanel>
                    <TextBlock Text="COLD STARTUP" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtStartupTime" Text="Measuring..." FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,0"/>
                    <TextBlock Text="Target: &lt; 1500 ms" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Working Set RAM -->
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4">
                <StackPanel>
                    <TextBlock Text="WORKING SET RAM" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtWorkingSetRam" Text="0 MB" FontSize="22" FontWeight="Bold" Foreground="#4ADE80" Margin="0,6,0,0"/>
                    <TextBlock Text="Budget: &lt; 150 - 250 MB" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Logical Cores & Render Mode -->
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4">
                <StackPanel>
                    <TextBlock Text="GRAPHICS &amp; CORES" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtRenderMode" Text="Hardware" FontSize="18" FontWeight="Bold" Foreground="#FACC15" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtCpuCores" Text="Cores: 1" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Status Score -->
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4">
                <StackPanel>
                    <TextBlock Text="HARDWARE RATING" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtRating" Text="EXCELLENT" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" Margin="0,6,0,0"/>
                    <TextBlock Text="100% Offline Capable" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Benchmark Execution Log Output -->
        <Border Grid.Row="2" Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="DIAGNOSTIC TEST EXECUTION LOG" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogOutput" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" FontFamily="Consolas" FontSize="13" BorderThickness="0" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="Bhavani Technology | Dharmesh Varia | Extremely Lightweight Educational Engine" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button x:Name="BtnTrimMemory" Content="🧹 Force GC Memory Trim" Click="BtnTrimMemory_Click" HorizontalAlignment="Right" Background="#334155" Foreground="White" Padding="10,6" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
